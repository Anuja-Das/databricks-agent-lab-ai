# Copy this file to .env and fill in your values
# Never commit .env to git

# Silence MLflow's git-not-found warnings
GIT_PYTHON_REFRESH=quiet

MLFLOW_RECORD_ENV_VARS_IN_MODEL_LOGGING=false

DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi_your_personal_access_token

# SQL Warehouse to run employee queries against
DATABRICKS_WAREHOUSE_ID=your_warehouse_id

# Unity Catalog location for the registered model
UC_CATALOG=workspace
UC_SCHEMA=default

# MLflow experiment path in the Databricks workspace (must start with /)
MLFLOW_EXPERIMENT_NAME=/Users/your-email@gmail.com/employee-agent

# The Databricks system AI model your agent uses (Gemma or other)
# Find available models: Databricks UI -> Serving -> Foundation Models
AI_MODEL_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Your employees table (3-level UC name)
EMPLOYEES_TABLE=main.default.employees

# Databricks AI/BI Genie Space ID
# Open your Genie space -> copy the ID from the URL: /genie/rooms/<SPACE_ID>
GENIE_SPACE_ID=your_genie_space_id
